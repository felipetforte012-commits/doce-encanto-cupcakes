# Modelo do arquivo .env (este arquivo de EXEMPLO pode ir para o GitHub).
# Copie para ".env" e preencha. O ".env" de verdade NUNCA vai para o GitHub.

# Conexão com o TiDB Cloud. Deixe vazio para usar o SQLite local (cupcakes.db).
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:4000/doce_encanto
DATABASE_URL=

# Chave secreta do Flask (obrigatória em produção). Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
